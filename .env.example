PORT=3000
# Replace with a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
# Set to true when the app is served over HTTPS
COOKIE_SECURE=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=wreso
DB_PASSWORD=wreso
DB_NAME=wreso
# Apply sql/schema.sql automatically on startup
DB_AUTO_MIGRATE=true

# Where uploaded media, thumbnails and renders are stored
STORAGE_DIR=./storage
# Max upload size in megabytes
MAX_UPLOAD_MB=2048

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Number of renders processed in parallel
RENDER_CONCURRENCY=1
